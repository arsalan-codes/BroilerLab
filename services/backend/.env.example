# BroilerLab Backend — environment
# Copy to .env and fill values.

# Database (dbmate + TypeORM use the same URL)
DATABASE_URL=postgres://broiler:broiler_dev@127.0.0.1:5433/broilerlab_ng?sslmode=disable

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=1209600      # seconds (14 days)

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# MQTT broker (EMQX)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=lab/dev/+/events

# API
PORT=3001
API_PREFIX=/api/v1
