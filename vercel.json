{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "../webapp/**;../migrations/**;../alembic.ini"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ws/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "trailingSlash": false
}